{
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(printenv:*)",
      "Bash(env:*)",
      "Bash(taskkill:*)",
      "Bash(Stop-Process:*)",
      "Bash(*Stop-Process*)",
      "Bash(pkill:*)",
      "Bash(kill:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: run ship-feature before the PR? Scratchpad progress tracker updated?'"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": true
}
